{
  "$schema": "https://schemas.analitiq.ai/type-map-write/latest.json",
  "direction": "write",
  "rules": [
    {
      "match": "exact",
      "native_type": "TINYINT(1)",
      "arrow_type": "Boolean"
    },
    {
      "match": "exact",
      "native_type": "TINYINT",
      "arrow_type": "Int8"
    },
    {
      "match": "exact",
      "native_type": "SMALLINT",
      "arrow_type": "Int16"
    },
    {
      "match": "exact",
      "native_type": "INT",
      "arrow_type": "Int32"
    },
    {
      "match": "exact",
      "native_type": "BIGINT",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "TINYINT UNSIGNED",
      "arrow_type": "UInt8"
    },
    {
      "match": "exact",
      "native_type": "SMALLINT UNSIGNED",
      "arrow_type": "UInt16"
    },
    {
      "match": "exact",
      "native_type": "INT UNSIGNED",
      "arrow_type": "UInt32"
    },
    {
      "match": "exact",
      "native_type": "BIGINT UNSIGNED",
      "arrow_type": "UInt64"
    },
    {
      "match": "exact",
      "native_type": "FLOAT",
      "arrow_type": "Float16"
    },
    {
      "match": "exact",
      "native_type": "FLOAT",
      "arrow_type": "Float32"
    },
    {
      "match": "exact",
      "native_type": "DOUBLE",
      "arrow_type": "Float64"
    },
    {
      "match": "regex",
      "native_type": "DECIMAL(${p}, ${s})",
      "arrow_type": "^Decimal(?:128|256)\\((?<p>[1-9]|[1-5]\\d|6[0-5]),\\s*(?<s>\\d|[12]\\d|30)\\)$"
    },
    {
      "match": "exact",
      "native_type": "TEXT",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "LONGTEXT",
      "arrow_type": "LargeUtf8"
    },
    {
      "match": "exact",
      "native_type": "JSON",
      "arrow_type": "Json"
    },
    {
      "match": "exact",
      "native_type": "BLOB",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "LONGBLOB",
      "arrow_type": "LargeBinary"
    },
    {
      "match": "regex",
      "native_type": "BINARY(${n})",
      "arrow_type": "^FixedSizeBinary\\((?<n>[1-9]\\d?|1\\d{2}|2[0-4]\\d|25[0-5])\\)$"
    },
    {
      "match": "regex",
      "native_type": "VARBINARY(${n})",
      "arrow_type": "^FixedSizeBinary\\((?<n>25[6-9]|2[6-9]\\d|[3-9]\\d{2}|[1-9]\\d{3}|[1-5]\\d{4}|6[0-4]\\d{3}|65[0-4]\\d{2}|655[0-2]\\d|6553[0-5])\\)$"
    },
    {
      "match": "exact",
      "native_type": "DATE",
      "arrow_type": "Date32"
    },
    {
      "match": "exact",
      "native_type": "DATE",
      "arrow_type": "Date64"
    },
    {
      "match": "regex",
      "native_type": "TIME(6)",
      "arrow_type": "^Duration\\([A-Z]+\\)$"
    },
    {
      "match": "regex",
      "native_type": "TIME(6)",
      "arrow_type": "^Time(?:32|64)\\([A-Z]+\\)$"
    },
    {
      "match": "regex",
      "native_type": "DATETIME(6)",
      "arrow_type": "^Timestamp\\([A-Z]+\\)$"
    },
    {
      "match": "regex",
      "native_type": "DATETIME(6)",
      "arrow_type": "^Timestamp\\([A-Z]+,\\s*.+\\)$"
    }
  ]
}
