{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "database",
  "connector_id": "2235d034-577f-40b7-b532-aaf1b10121ac",
  "display_name": "MySQL",
  "description": "Open-source relational database management system for structured data storage, querying, and management",
  "documentation_url": "https://dev.mysql.com/doc/refman/8.0/en/",
  "version": "0.1.1",
  "default_transport": "database",
  "transports": {
    "database": {
      "transport_type": "sqlalchemy",
      "driver": "mysql+aiomysql",
      "dsn": {
        "kind": "url_template",
        "template": "mysql+aiomysql://{username}:{password}@{host}:{port}/{database}",
        "bindings": {
          "username": {
            "value": {
              "ref": "connection.parameters.username"
            },
            "encoding": "url_userinfo"
          },
          "password": {
            "value": {
              "ref": "secrets.password"
            },
            "encoding": "url_userinfo"
          },
          "host": {
            "value": {
              "ref": "connection.parameters.host"
            },
            "encoding": "host"
          },
          "port": {
            "value": {
              "ref": "connection.parameters.port"
            },
            "encoding": "raw"
          },
          "database": {
            "value": {
              "ref": "connection.parameters.database"
            },
            "encoding": "url_path_segment"
          }
        }
      },
      "tls": {
        "mode": {
          "ref": "connection.parameters.ssl_mode"
        },
        "ca_certificate": {
          "ref": "secrets.ssl_ca_certificate"
        }
      }
    }
  },
  "auth": {
    "type": "db"
  },
  "connection_contract": {
    "inputs": {
      "host": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "default": "127.0.0.1",
        "ui": {
          "label": "Host",
          "widget": "text",
          "placeholder": "e.g. 127.0.0.1 or db.example.com"
        }
      },
      "port": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "integer",
        "required": true,
        "default": 3306,
        "ui": {
          "label": "Port",
          "widget": "text"
        }
      },
      "database": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Database",
          "widget": "text",
          "placeholder": "e.g. my_database"
        }
      },
      "username": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Username",
          "widget": "text",
          "placeholder": "e.g. root"
        }
      },
      "password": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true,
        "ui": {
          "label": "Password",
          "widget": "password"
        }
      },
      "ssl_mode": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "default": "PREFERRED",
        "enum": [
          "DISABLED",
          "PREFERRED",
          "REQUIRED",
          "VERIFY_CA",
          "VERIFY_IDENTITY"
        ],
        "ui": {
          "label": "SSL Mode",
          "widget": "select",
          "help_text": "MySQL-native TLS mode. Values are case-sensitive and correspond directly to MySQL client `--ssl-mode` semantics.",
          "options": [
            {
              "label": "DISABLED — no TLS (plaintext only)",
              "value": "DISABLED"
            },
            {
              "label": "PREFERRED — try TLS, fall back to plaintext (default)",
              "value": "PREFERRED"
            },
            {
              "label": "REQUIRED — require TLS, no fallback",
              "value": "REQUIRED"
            },
            {
              "label": "VERIFY_CA — require TLS and verify server CA",
              "value": "VERIFY_CA"
            },
            {
              "label": "VERIFY_IDENTITY — require TLS, verify server CA, and verify hostname matches certificate",
              "value": "VERIFY_IDENTITY"
            }
          ]
        }
      },
      "ssl_ca_certificate": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "secrets",
        "type": "string",
        "required": false,
        "secret": true,
        "ui": {
          "label": "SSL CA Certificate",
          "widget": "textarea",
          "help_text": "PEM-encoded CA certificate used to verify the MySQL server's TLS certificate. Required when ssl_mode is VERIFY_CA or VERIFY_IDENTITY; ignored otherwise."
        }
      }
    },
    "validation": {
      "rules": [
        {
          "when": {
            "field": "ssl_mode",
            "operator": "in",
            "value": [
              "VERIFY_CA",
              "VERIFY_IDENTITY"
            ]
          },
          "require": [
            "ssl_ca_certificate"
          ],
          "message": "ssl_ca_certificate is required when ssl_mode is VERIFY_CA or VERIFY_IDENTITY"
        }
      ]
    }
  }
}
