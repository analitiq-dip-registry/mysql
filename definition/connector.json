{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "database",
  "connector_id": "mysql",
  "display_name": "MySQL",
  "description": "MySQL open-source relational database. Connects over the MySQL wire protocol via the async SQLAlchemy mysql+aiomysql dialect for structured data storage, querying, runtime table discovery, and DDL/write-back.",
  "documentation_url": "https://dev.mysql.com/doc/refman/8.0/en/",
  "tags": [
    "database",
    "mysql",
    "sql",
    "sqlalchemy",
    "relational"
  ],
  "version": "0.3.0",
  "default_transport": "database",
  "transports": {
    "database": {
      "transport_type": "sqlalchemy",
      "driver": "mysql+aiomysql",
      "dsn": {
        "kind": "url_template",
        "template": "mysql+aiomysql://{username}:{password}@{host}:{port}/{database}",
        "bindings": {
          "username": {
            "value": {
              "ref": "connection.parameters.username"
            },
            "encoding": "url_userinfo"
          },
          "password": {
            "value": {
              "ref": "secrets.password"
            },
            "encoding": "url_userinfo"
          },
          "host": {
            "value": {
              "ref": "connection.parameters.host"
            },
            "encoding": "host"
          },
          "port": {
            "value": {
              "ref": "connection.parameters.port"
            },
            "encoding": "raw"
          },
          "database": {
            "value": {
              "ref": "connection.parameters.database"
            },
            "encoding": "url_path_segment"
          }
        }
      },
      "tls": {
        "mode": {
          "ref": "connection.parameters.ssl_mode"
        },
        "ca_certificate": {
          "ref": "secrets.ssl_ca_certificate"
        }
      }
    }
  },
  "auth": {
    "type": "db"
  },
  "connection_contract": {
    "inputs": {
      "host": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "default": "127.0.0.1",
        "ui": {
          "label": "Host",
          "widget": "text",
          "placeholder": "e.g. 127.0.0.1 or db.example.com",
          "help_text": "Use an IP or DNS name reachable over TCP/IP. Prefer 127.0.0.1 over 'localhost' to avoid DNS/IPv6 resolution ambiguity."
        }
      },
      "port": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "integer",
        "required": true,
        "default": 3306,
        "ui": {
          "label": "Port",
          "widget": "text"
        }
      },
      "database": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Database",
          "widget": "text",
          "placeholder": "e.g. my_database"
        }
      },
      "username": {
        "source": "user",
        "phase": "auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Username",
          "widget": "text",
          "placeholder": "e.g. root"
        }
      },
      "password": {
        "source": "user",
        "phase": "auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true,
        "ui": {
          "label": "Password",
          "widget": "password"
        }
      },
      "ssl_mode": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "default": "PREFERRED",
        "enum": [
          "DISABLED",
          "PREFERRED",
          "REQUIRED",
          "VERIFY_CA",
          "VERIFY_IDENTITY"
        ],
        "ui": {
          "label": "SSL Mode",
          "widget": "select",
          "help_text": "MySQL-native TLS mode vocabulary (--ssl-mode). REQUIRED, VERIFY_CA, and VERIFY_IDENTITY are enforced post-connect: every new connection is verified to be encrypted and fails if it is not. DISABLED and PREFERRED do not promise encryption.",
          "options": [
            {
              "label": "DISABLED — no TLS (plaintext only)",
              "value": "DISABLED"
            },
            {
              "label": "PREFERRED — try TLS, fall back to plaintext (default)",
              "value": "PREFERRED"
            },
            {
              "label": "REQUIRED — require TLS (verified post-connect), no certificate verification",
              "value": "REQUIRED"
            },
            {
              "label": "VERIFY_CA — require TLS, verify server CA",
              "value": "VERIFY_CA"
            },
            {
              "label": "VERIFY_IDENTITY — require TLS, verify server CA and hostname",
              "value": "VERIFY_IDENTITY"
            }
          ]
        }
      },
      "ssl_ca_certificate": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "secrets",
        "type": "string",
        "required": false,
        "secret": true,
        "ui": {
          "label": "SSL CA Certificate",
          "widget": "textarea",
          "help_text": "PEM-encoded CA certificate used to verify the MySQL server's TLS certificate. Required when ssl_mode is VERIFY_CA or VERIFY_IDENTITY; ignored otherwise."
        }
      }
    },
    "validation": {
      "rules": [
        {
          "when": {
            "field": "ssl_mode",
            "in": [
              "VERIFY_CA",
              "VERIFY_IDENTITY"
            ]
          },
          "require": [
            "ssl_ca_certificate"
          ],
          "message": "ssl_ca_certificate is required when ssl_mode is VERIFY_CA or VERIFY_IDENTITY"
        }
      ]
    }
  },
  "resource_discovery": {
    "strategy": "information_schema",
    "transport_ref": "database",
    "implementation": {
      "type": "builtin"
    },
    "produces": [
      "connection.endpoints",
      "connection.type_map"
    ],
    "triggers": {
      "list_resources": "on_activation",
      "describe_resource": "on_resource_selected"
    }
  }
}
