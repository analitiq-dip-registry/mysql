{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "database",
  "connector_id": "mysql",
  "display_name": "MySQL",
  "description": "MySQL relational database (8.4 LTS). Reads and writes over the async SQLAlchemy mysql+aiomysql transport: username/password authentication, MySQL's own --ssl-mode TLS vocabulary (DISABLED through VERIFY_IDENTITY) with a post-connect Ssl_cipher enforcement probe, schema/table/view discovery via information_schema, and declared SQL write-path capabilities (stage-then-merge with CREATE TEMPORARY TABLE ... LIKE and INSERT ... ON DUPLICATE KEY UPDATE). The session is pinned to SET time_zone = '+00:00' so TIMESTAMP values carry a well-defined UTC instant. No first-class ADBC driver and no Arrow Flight SQL endpoint exist for MySQL, so the SQLAlchemy transport is the only supported path; batches land via executemany (LOAD DATA LOCAL INFILE is not reachable through the engine's connect-argument surface - see the connector README).",
  "documentation_url": "https://dev.mysql.com/doc/refman/8.4/en/",
  "tags": [
    "database",
    "mysql",
    "sql",
    "sqlalchemy",
    "relational"
  ],
  "version": "0.3.1",
  "default_transport": "database",
  "transports": {
    "database": {
      "transport_type": "sqlalchemy",
      "driver": "mysql+aiomysql",
      "dsn": {
        "kind": "url_template",
        "template": "mysql+aiomysql://{username}:{password}@{host}:{port}/{database}",
        "bindings": {
          "username": {
            "value": {
              "ref": "connection.parameters.username"
            },
            "encoding": "url_userinfo"
          },
          "password": {
            "value": {
              "ref": "secrets.password"
            },
            "encoding": "url_userinfo"
          },
          "host": {
            "value": {
              "ref": "connection.parameters.host"
            },
            "encoding": "host"
          },
          "port": {
            "value": {
              "ref": "connection.parameters.port"
            },
            "encoding": "raw"
          },
          "database": {
            "value": {
              "ref": "connection.parameters.database"
            },
            "encoding": "url_path_segment"
          }
        }
      },
      "tls": {
        "mode": {
          "ref": "connection.parameters.ssl_mode"
        },
        "ca_certificate": {
          "ref": "secrets.ssl_ca_certificate"
        }
      }
    }
  },
  "auth": {
    "type": "db"
  },
  "connection_contract": {
    "inputs": {
      "host": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Host",
          "widget": "text",
          "placeholder": "e.g. db.example.com or 127.0.0.1",
          "help_text": "Hostname or IP address of the MySQL server. On Unix, the literal 'localhost' makes the client use a Unix socket file instead of TCP; use 127.0.0.1 for a TCP connection."
        }
      },
      "port": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "integer",
        "required": true,
        "default": 3306,
        "ui": {
          "label": "Port",
          "widget": "number",
          "help_text": "TCP port the server listens on; MySQL's documented default is 3306."
        }
      },
      "database": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Database",
          "widget": "text",
          "placeholder": "e.g. my_database",
          "help_text": "MySQL uses 'database' and 'schema' interchangeably - there is no catalog level above it."
        }
      },
      "username": {
        "source": "user",
        "phase": "auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Username",
          "widget": "text",
          "placeholder": "e.g. analitiq"
        }
      },
      "password": {
        "source": "user",
        "phase": "auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true,
        "ui": {
          "label": "Password",
          "widget": "password"
        }
      },
      "ssl_mode": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "default": "PREFERRED",
        "enum": [
          "DISABLED",
          "PREFERRED",
          "REQUIRED",
          "VERIFY_CA",
          "VERIFY_IDENTITY"
        ],
        "ui": {
          "label": "SSL Mode",
          "widget": "select",
          "help_text": "MySQL's own --ssl-mode vocabulary. PREFERRED (MySQL's documented default) encrypts when the server supports it and silently falls back to plaintext; REQUIRED and above forbid that fallback and are enforced post-connect via SHOW STATUS LIKE 'Ssl_cipher'. Per MySQL semantics REQUIRED does not verify the server certificate - use VERIFY_CA or VERIFY_IDENTITY, which require a PEM CA bundle.",
          "options": [
            {
              "value": "DISABLED",
              "label": "Disabled - unencrypted connection"
            },
            {
              "value": "PREFERRED",
              "label": "Preferred - encrypt if the server supports it (default)"
            },
            {
              "value": "REQUIRED",
              "label": "Required - encrypt or fail; no certificate verification"
            },
            {
              "value": "VERIFY_CA",
              "label": "Verify CA - encrypt and verify the server certificate against the CA"
            },
            {
              "value": "VERIFY_IDENTITY",
              "label": "Verify Identity - also verify the server host name"
            }
          ]
        }
      },
      "ssl_ca_certificate": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "secrets",
        "type": "string",
        "required": false,
        "secret": true,
        "ui": {
          "label": "SSL CA Certificate",
          "widget": "textarea",
          "help_text": "PEM-encoded CA certificate (MySQL's --ssl-ca). Required when SSL Mode is VERIFY_CA or VERIFY_IDENTITY; ignored for the other modes."
        }
      }
    },
    "required_for_activation": [
      "connection.parameters.host",
      "connection.parameters.port",
      "connection.parameters.database",
      "connection.parameters.username",
      "secrets.password"
    ],
    "validation": {
      "rules": [
        {
          "when": {
            "field": "ssl_mode",
            "in": [
              "VERIFY_CA",
              "VERIFY_IDENTITY"
            ]
          },
          "require": [
            "ssl_ca_certificate"
          ],
          "message": "ssl_ca_certificate is required when ssl_mode is VERIFY_CA or VERIFY_IDENTITY"
        }
      ]
    }
  },
  "sql_capabilities": {
    "catalog": "none",
    "session_targeting": "per_statement",
    "merge_form": "insert_on_duplicate_key",
    "bulk_load": {},
    "stage": {
      "scope": "temp",
      "schema": "target",
      "transactional_ddl": false
    },
    "limits": {
      "max_bind_params": 65535,
      "max_identifier_len": 64
    }
  },
  "write_unit": {
    "rows": 5000,
    "bytes": 4194304
  },
  "resource_discovery": {
    "strategy": "information_schema",
    "transport_ref": "database",
    "implementation": {
      "type": "builtin"
    },
    "options": {
      "exclude_schemas": [
        "information_schema",
        "mysql",
        "performance_schema",
        "sys"
      ]
    },
    "produces": [
      "connection.endpoints",
      "connection.type_map"
    ],
    "triggers": {
      "list_resources": "on_activation",
      "describe_resource": "on_resource_selected"
    }
  }
}
